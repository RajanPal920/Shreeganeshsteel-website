# Shree Ganesh Steel Corporation - EmailJS Configuration
# Recipient Email for business inquiries: shreeganeshsteel29@gmail.com

# EmailJS Service ID (Connected to shreeganeshsteel29@gmail.com in EmailJS Dashboard)
VITE_EMAILJS_SERVICE_ID=service_your_service_id

# EmailJS Template ID (Inquiry email template sent to business)
VITE_EMAILJS_TEMPLATE_ID=template_your_template_id

# EmailJS Public Key (Found in EmailJS Dashboard -> Account -> General -> Public Key)
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# Optional: EmailJS Template ID for auto-confirmation reply sent to the customer's email
VITE_EMAILJS_CONFIRMATION_TEMPLATE_ID=template_your_confirmation_id
